# ─── App ─────────────────────────────────────────────────────────────────────

# Node environment: "development" | "production" | "test"
NODE_ENV=development

# Port the Express server listens on (default: 3000)
PORT=3000

# ─── Session ─────────────────────────────────────────────────────────────────

# Secret used to sign session cookies.
# Use a long, random string in production (e.g. openssl rand -base64 32)
SESSION_SECRET=your_session_secret_here

# ─── Database (Vercel Postgres / Neon — Pooled + Direct) ─────────────────────

# Pooled connection URL — used by Prisma Client at runtime (PgBouncer-compatible)
POSTGRES_PRISMA_URL=postgresql://user:password@host:5432/dbname?pgbouncer=true&connect_timeout=15

# Direct (non-pooling) connection URL — used by Prisma Migrate
POSTGRES_URL_NON_POOLING=postgresql://user:password@host:5432/dbname

# ─── Database (Local PostgreSQL — uncomment to use) ──────────────────────────

# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/todo_dev
