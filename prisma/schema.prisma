// schema.prisma

generator client {
  provider = "prisma-client-js"
}

// vercel database
datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

// local
// datasource db {
//   provider = "postgresql"
//   url      = env("DATABASE_URL")
// }

enum TodoStatus {
  ON_HOLD
  COMPLETED
  IN_PROGRESS
}

model User {
  uid        String     @id @default(uuid())
  name       String
  username   String     @unique
  pass       String
  todos      Todo[]
  categories Category[]
  sub_todos  SubTodo[]
}

model Todo {
  id          String     @id @default(uuid())
  user_id     String
  title       String
  completed   Boolean    @default(false)
  category_id String?
  status      TodoStatus @default(IN_PROGRESS)
  bookmarked  Boolean    @default(false)
  created_at  DateTime   @default(now())
  updated_at  DateTime   @updatedAt
  user        User       @relation(fields: [user_id], references: [uid], onDelete: Cascade, onUpdate: Cascade)
  category    Category?  @relation(fields: [category_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
  sub_todos   SubTodo[]
}

model Category {
  id            String @id @default(uuid())
  user_id       String
  category_name String
  display_name  String
  user          User   @relation(fields: [user_id], references: [uid], onDelete: Cascade, onUpdate: Cascade)
  todos         Todo[]
}

model SubTodo {
  id         String     @id @default(uuid())
  user_id    String
  todo_id    String
  title      String
  completed  Boolean    @default(false)
  status     TodoStatus @default(IN_PROGRESS)
  created_at DateTime   @default(now())
  updated_at DateTime   @updatedAt
  user       User       @relation(fields: [user_id], references: [uid], onDelete: Cascade, onUpdate: Cascade)
  todo       Todo       @relation(fields: [todo_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
}
